$("inboxForm").onsubmit=e=>{e.preventDefault();let msg=$("messageInput").value.trim();if(!msg)return;let sender=$("senderEmail").value.trim();let body=encodeURIComponent((sender?"Sender email: "+sender+"\n\n":"")+msg);location.href=`mailto:${EMAIL}?subject=${encodeURIComponent("Message from Zisan website")}&body=${body}`};
