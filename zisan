$("lang").onclick=()=>{lang=lang==="bn"?"en":"bn";document.documentElement.lang=lang;$("lang").textContent=tr("toggle");const map={eyebrow:"eyebrow",heroText:"hero",view:"view",message:"message",postsTitle:"posts",postsSub:"postsSub",composerSub:"composer",chooseText:"choose",publish:"publish",postHint:"hint",inboxTitle:"inbox",inboxSub:"inboxSub",emailLabel:"emailLabel",messageLabel:"messageLabel",sendBtn:"send",inboxNotice:"notice",footer:"footer"};Object.entries(map).forEach(([id,k])=>$(id).textContent=tr(k));$("captionInput").placeholder=lang==="bn"?"কী শেয়ার করতে চাও? (ঐচ্ছিক)":"What would you like to share? (optional)";$("messageInput").placeholder=tr("placeholder");render()};
function resize(file){return new Promise((resolve,reject)=>{let r=new FileReader();r.onerror=reject;r.onload=()=>{let im=new Image();im.onerror=reject;im.onload=()=>{let s=Math.min(1,1200/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);c.getContext("2d").drawImage(im,0,0,c.width,c.height);resolve(c.toDataURL("image/jpeg",.8))};im.src=r.result};r.readAsDataURL(file)})}
